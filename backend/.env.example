# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY='change-me-to-a-long-random-string'
DJANGO_DEBUG=True

# PostgreSQL + PostGIS
DB_NAME=hifazat_db
DB_USER=hifazat_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis (Django Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (password reset codes). Leave EMAIL_HOST empty to print emails to the console.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Hifazat <you@gmail.com>
